generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model gyms {
  id                          String                @id @default(uuid())
  gym_name                    String
  gym_id                      String                @unique
  owner_name                  String
  email                       String                @unique
  phone                       String
  password_hash               String
  plan                        String                @default("trial")
  email_verified              Boolean               @default(false)
  email_notifications_enabled Boolean               @default(true)
  email_daily_summary_enabled Boolean               @default(false)
  verification_token          String?               @unique
  otp_code                    String?
  otp_expires_at              DateTime?
  trial_start_date            DateTime              @default(now())
  trial_end_date              DateTime
  subscription_status         String                @default("inactive")
  razorpay_key_id             String?
  razorpay_key_secret         String?
  logo_url                    String?
  created_at                  DateTime              @default(now())
  attendances                 attendances[]
  email_notifications         email_notifications[]
  fitness_tips                fitness_tips[]
  notifications               gym_notifications[]
  gym_subscriptions           gym_subscriptions[]
  members                     members[]
  membership_plans            membership_plans[]
  payments                    payments[]
  reminder_settings           reminder_settings?
  trainer_sessions            trainer_sessions[]
  trainers                    trainers[]
  trial_users                 trial_users[]
}

model gym_subscriptions {
  id                       String   @id @default(uuid())
  gym_id                   String
  plan_name                String
  status                   String
  start_date               DateTime
  end_date                 DateTime
  razorpay_subscription_id String?
  created_at               DateTime @default(now())
  gym                      gyms     @relation(fields: [gym_id], references: [id])
}

model members {
  id                String              @id @default(uuid())
  gym_id            String
  name              String
  phone             String
  email             String?
  dob               DateTime?
  plan_duration     Int
  start_date        DateTime
  expiry_date       DateTime
  amount            Float
  payment_status    String?
  payment_method    String?
  reminder_7_sent   Boolean             @default(false)
  expiry_notified   Boolean             @default(false)
  is_paused         Boolean             @default(false)
  paused_at         DateTime?
  paused_total_days Int                 @default(0)
  is_inactive       Boolean             @default(false)
  inactive_since    DateTime?
  created_at        DateTime            @default(now())
  plan_id           String?
  attendances       attendances[]
  gym_notifications gym_notifications[]
  gym               gyms                @relation(fields: [gym_id], references: [id])
  membership_plan   membership_plans?   @relation(fields: [plan_id], references: [id])
  payments          payments[]
  trainer_sessions  trainer_sessions[]

  @@index([gym_id])
  @@index([gym_id, is_inactive])
  @@index([gym_id, expiry_date])
  @@index([gym_id, is_inactive, expiry_date])
  @@index([gym_id, payment_status])
  @@index([gym_id, payment_method])
  @@index([gym_id, created_at])
  @@index([gym_id, is_inactive, created_at])
  @@index([gym_id, inactive_since])
  @@index([gym_id, is_inactive, inactive_since])
  @@index([expiry_date])
  @@index([payment_status])
  @@index([plan_id])
  @@index([gym_id, email])
  @@index([gym_id, phone])
}

model payments {
  id                  String   @id @default(uuid())
  gym_id              String
  member_id           String?
  razorpay_payment_id String?  @unique
  razorpay_order_id   String?
  amount              Float
  status              String
  created_at          DateTime @default(now())
  gym                 gyms     @relation(fields: [gym_id], references: [id])
  member              members? @relation(fields: [member_id], references: [id])

  @@index([razorpay_order_id])
  @@index([gym_id, status, created_at])
  @@index([gym_id, member_id, created_at])
}

model trainers {
  id               String             @id @default(uuid())
  gym_id           String
  name             String
  email            String?            @unique
  phone            String?
  specialization   String?
  experience_years Int                @default(0)
  hourly_rate      Float?
  salary_amount    Float?
  salary_basis     String?
  status           String             @default("active")
  created_at       DateTime           @default(now())
  attendances      attendances[]
  trainer_sessions trainer_sessions[]
  gym              gyms               @relation(fields: [gym_id], references: [id])

  @@index([gym_id])
}

model trainer_sessions {
  id               String   @id @default(uuid())
  gym_id           String
  trainer_id       String
  member_id        String?
  session_date     DateTime
  duration_minutes Int
  status           String   @default("scheduled")
  notes            String?
  created_at       DateTime @default(now())
  gym              gyms     @relation(fields: [gym_id], references: [id])
  member           members? @relation(fields: [member_id], references: [id])
  trainer          trainers @relation(fields: [trainer_id], references: [id])

  @@index([gym_id])
  @@index([trainer_id])
  @@index([member_id])
}

model attendances {
  id          String    @id @default(uuid())
  gym_id      String
  member_id   String
  trainer_id  String?
  checkin_at  DateTime  @default(now())
  checkout_at DateTime?
  source      String?
  created_at  DateTime  @default(now())
  gym         gyms      @relation(fields: [gym_id], references: [id])
  member      members   @relation(fields: [member_id], references: [id])
  trainer     trainers? @relation(fields: [trainer_id], references: [id])

  @@index([gym_id])
  @@index([member_id])
  @@index([trainer_id])
  @@index([checkin_at])
  @@index([gym_id, checkin_at, member_id])
}

model gym_notifications {
  id        String   @id @default(uuid())
  gym_id    String
  member_id String?
  type      String
  message   String
  sent_at   DateTime @default(now())
  status    String   @default("pending")
  gym       gyms     @relation(fields: [gym_id], references: [id])
  member    members? @relation(fields: [member_id], references: [id])

  @@index([gym_id])
  @@index([member_id])
}

model membership_plans {
  id            String    @id @default(uuid())
  gym_id        String
  name          String
  duration_days Int
  price         Float
  description   String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  members       members[]
  gym           gyms      @relation(fields: [gym_id], references: [id])

  @@unique([gym_id, name])
  @@index([gym_id])
}

model reminder_settings {
  id                               String   @id @default(uuid())
  gym_id                           String   @unique
  reminder_7_days_before           Int      @default(7)
  expiry_email_delay_days          Int      @default(0)
  enable_expiry_email              Boolean  @default(true)
  enable_owner_daily_summary_email Boolean  @default(true)
  enable_7_day_reminder            Boolean  @default(true)
  enable_birthday_message          Boolean  @default(true)
  enable_inactive_reminder         Boolean  @default(false)
  inactive_days_threshold          Int      @default(14)
  member_email_send_hour           Int      @default(10)
  member_email_send_minute         Int      @default(0)
  email_subject_expiring           String   @default("Your membership at {gym_name} expires on {expiry_date}")
  email_body_expiring              String   @default("Hi {member_name},\n\nThis is a reminder from {gym_name} that your membership will expire on {expiry_date}.\n\nAmount due: {amount_due}\n\nPlease renew before the expiry date to continue uninterrupted access.\n\nThanks,\n{gym_name}")
  email_subject_expired            String   @default("Your membership at {gym_name} has expired")
  email_body_expired               String   @default("Hi {member_name},\n\nYour membership at {gym_name} expired on {expiry_date}.\n\nAmount due: {amount_due}\n\nPlease renew to reactivate your access.\n\nThanks,\n{gym_name}")
  message_birthday                 String   @default("Happy Birthday {{member_name}}! 🎉\nYour {{gym_name}} family wishes you a strong and healthy year ahead.")
  email_subject_birthday           String   @default("Happy Birthday from {gym_name}!")
  email_body_birthday              String   @default("Hi {member_name},\n\nHappy Birthday from everyone at {gym_name}.\n\nWishing you a strong, healthy, and successful year ahead.\n\nThanks,\n{gym_name}")
  email_subject_inactive           String   @default("We miss you at {gym_name}")
  email_body_inactive              String   @default("Hi {member_name},\n\nWe haven't seen you at {gym_name} recently.\n\nCome back this week and keep your progress going.\n\nThanks,\n{gym_name}")
  created_at                       DateTime @default(now())
  updated_at                       DateTime @updatedAt
  gym                              gyms     @relation(fields: [gym_id], references: [id])

  @@index([gym_id])
}

model fitness_tips {
  id         String   @id @default(uuid())
  gym_id     String
  title      String
  message    String
  category   String
  created_at DateTime @default(now())
  gym        gyms     @relation(fields: [gym_id], references: [id])

  @@index([gym_id])
  @@index([category])
}

model trial_users {
  id                 String   @id @default(uuid())
  gym_id             String
  name               String
  phone              String
  trial_date         DateTime
  trial_duration     Int      @default(7)
  trainer_name       String?
  notes              String?
  lost_reason        String?
  status             String   @default("trial")
  reminder_day1_sent Boolean  @default(false)
  reminder_day2_sent Boolean  @default(false)
  reminder_day5_sent Boolean  @default(false)
  created_at         DateTime @default(now())
  gym                gyms     @relation(fields: [gym_id], references: [id])

  @@index([gym_id])
  @@index([status])
}

model email_notifications {
  id            String   @id @default(uuid())
  gym_id        String
  type          String
  status        String
  subject       String?
  payload       Json?
  error_message String?
  retry_count   Int      @default(0)
  sent_at       DateTime @default(now())
  gym           gyms     @relation(fields: [gym_id], references: [id])

  @@index([gym_id])
  @@index([status])
  @@index([type])
}

model website_pricing_settings {
  id                     String   @id @default("default")
  tagline                String   @default("Affordable pricing designed for growing gyms")
  billing_toggle_enabled Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
}

model website_pricing_plans {
  id                          String   @id @default(uuid())
  name                        String
  description                 String?
  monthly_price               Float?
  monthly_discount_type       String?
  monthly_discount_value      Float?
  yearly_price                Float?
  yearly_discount_type        String?
  yearly_discount_value       Float?
  features                    Json
  cta_label                   String   @default("Choose Plan")
  badge_text                  String?
  is_recommended              Boolean  @default(false)
  is_visible                  Boolean  @default(true)
  has_custom_feature_requests Boolean  @default(false)
  sort_order                  Int      @default(0)
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  @@index([is_visible, sort_order])
}

model website_inquiries {
  id         String   @id @default(uuid())
  name       String
  gym_name   String
  phone      String
  email      String
  message    String?
  status     String   @default("new")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, created_at])
  @@index([created_at])
}

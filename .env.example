NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=change-this-admin-password
AES_SECRET=replace-with-a-32-byte-secret
RATE_LIMIT_MAX=150
ENABLE_CRONS=false
FRONTEND_URL=https://sienna-hawk-345174.hostingersite.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=noreply@example.com
BOOKING_NOTIFICATION_EMAILS=owner1@example.com,owner2@example.com
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
PAYMENT_CALLBACK_URL=http://localhost:8080/payment
CRON_TIMEZONE=Asia/Kolkata
MEMBER_EMAIL_REMINDER_CRON=0 9 * * *
OWNER_DAILY_SUMMARY_CRON=0 20 * * *
ANALYTICS_CACHE_TTL_MS=30000
DASHBOARD_MAX_INFLIGHT=20
WHATSAPP_WEB_ENABLED=true
WHATSAPP_WEB_AUTO_RESTORE=true
WHATSAPP_WEB_AUTH_DATA_PATH=./.wwebjs_auth
WHATSAPP_WEB_MIN_MEMORY_MB=768
WHATSAPP_WEB_FORCE_START=false
PUPPETEER_INSTALL_CHROME=false
